# Option A: Gemini API key from Google AI Studio (simplest for a personal build)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Option B: Vertex AI (uncomment and fill in instead of option A)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Live model. Check the Live API model list if this name has moved on.
# AI Studio example: gemini-2.5-flash-native-audio-preview-12-2025 or gemini-3.1-flash-live-preview
# Vertex example:    gemini-live-2.5-flash-native-audio
VOICE_AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Prebuilt voice name. Native audio voices speak both Arabic and English.
VOICE_AGENT_VOICE=Puck
